{
  "name": "@drizzle-tx/core",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      },
      "default": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "testing"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test-d.json",
    "check:publish": "pnpm build && publint --strict && attw --pack ."
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.4"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "@types/pg": "catalog:",
    "tsdown": "0.22.4",
    "publint": "^0.3.21",
    "@arethetypeswrong/cli": "^0.18.4",
    "typescript": "catalog:"
  }
}
